# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=todo_app_db
DB_USER=todo_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Frontend URL used in password-reset links
FRONTEND_URL=http://localhost:5173

# SMTP (optional in development; console backend is used when omitted)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Todo Management <noreply@todo-management.local>
